# PYNQ 4.0.0 / AMD EDF 2025.2, stock 4 GiB PS DDR configuration.
EDF_MANIFEST_TAG=amd-edf-rel-v25.11.1
EDF_MODE=custom
EDF_BOOT_MACHINE=zynqmp-zcu216-pynq
EDF_LINUX_MACHINE=zynqmp-zcu216-pynq
EDF_BOARD_DTS=zcu216-reva
BSP_XSA_PATH=hardware/ps.xsa
# Low bank is 2 GiB; high bank is the remaining 2 GiB, not the architectural maximum.
EDF_DDR_HIGH_BANK_REG="0x8 0x0 0x0 0x80000000"
